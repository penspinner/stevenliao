{
  "name": "stevenliao",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev:next": "turbo run dev watch --filter app-next --filter personal-site",
    "dev:react-router": "turbo run dev watch --filter app-react-router --filter personal-site",
    "check:lint": "oxlint",
    "check:fmt": "oxfmt --check .",
    "check:ts": "turbo run check:ts",
    "fmt": "oxfmt .",
    "typegen": "turbo run typegen"
  },
  "devDependencies": {
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "tsconfig": "workspace:*",
    "turbo": "^2.9.7"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8"
}
