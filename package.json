{
  "name": "stevenliao",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check:fmt": "oxfmt --check .",
    "check:lint": "oxlint",
    "check:ts": "turbo run check:ts",
    "dev:next": "turbo run dev watch --filter app-next --filter personal-site",
    "dev:react-router": "turbo run dev watch --filter app-react-router --filter personal-site",
    "fmt": "oxfmt .",
    "typegen": "turbo run typegen"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "oxlint-tsgolint": "^0.22.1",
    "tsconfig": "workspace:*",
    "turbo": "^2.9.12"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "packageManager": "bun@1.3.13"
}
