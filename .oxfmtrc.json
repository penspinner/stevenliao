{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": false,
  "singleQuote": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "sortImports": true,
  "sortPackageJson": {
    "sortScripts": true
  },
  "sortTailwindcss": true,
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/api/**",
    "**/public/build/**",
    "**/.cache/**",
    "**/.turbo/**",
    "**/storybook-static/**",
    "**/node_modules/**",
    "bun.lock"
  ]
}
