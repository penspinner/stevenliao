{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "unicorn", "import", "jsx-a11y", "nextjs"],
  "options": {
    "typeAware": true,
    "typeCheck": true,
    "reportUnusedDisableDirectives": "error"
  },
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "import/no-default-export": "error",
    "no-unused-expressions": "off",
    "react-hooks/rules-of-hooks": "error",
    "react-hooks/exhaustive-deps": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-unused-vars": ["error", { "ignoreRestSiblings": true }],
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "unicorn/no-new-array": "off"
  },
  "overrides": [
    {
      "files": [
        "apps/app-next/app/**/*.{ts,tsx}",
        "apps/app-next/next.config.{js,mjs}",
        "apps/app-next/postcss.config.mjs"
      ],
      "rules": {
        "import/no-default-export": "off",
        "unicorn/filename-case": ["error", { "cases": { "camelCase": true, "kebabCase": true } }]
      }
    },
    {
      "files": [
        "apps/app-react-router/app/routes/**/_route.tsx",
        "apps/app-react-router/app/routes/**/_index.tsx",
        "apps/app-react-router/app/routes/*.tsx",
        "apps/app-react-router/app/routes/*.ts",
        "apps/app-react-router/app/root.tsx",
        "apps/app-react-router/app/routes.ts",
        "apps/app-react-router/app/entry.client.tsx",
        "apps/app-react-router/app/entry.server.tsx",
        "apps/app-react-router/react-router.config.ts",
        "apps/app-react-router/vite.config.ts"
      ],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["apps/app-react-router/app/routes/**/*"],
      "rules": {
        "unicorn/filename-case": ["error", { "cases": { "camelCase": true, "kebabCase": true } }]
      }
    },
    {
      "files": [
        "apps/app-tanstack-react-start/**/*",
        "apps/app-react-router/**/*",
        "packages/personal-site/**/*",
        "packages/ui/**/*"
      ],
      "rules": {
        "nextjs/no-img-element": "off",
        "nextjs/no-html-link-for-pages": "off",
        "nextjs/no-head-element": "off"
      }
    },
    {
      "files": ["**/*.stories.*", "**/.storybook/*"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["**/*.test.*"],
      "rules": {
        "typescript/no-non-null-assertion": "off"
      }
    },
    {
      "files": [
        "apps/app-tanstack-react-start/src/routes/**/*",
        "apps/app-tanstack-react-start/src/router.tsx",
        "apps/app-tanstack-react-start/vite.config.ts"
      ],
      "rules": {
        "import/no-default-export": "off",
        "nextjs/no-img-element": "off",
        "nextjs/no-html-link-for-pages": "off",
        "nextjs/no-head-element": "off"
      }
    },
    {
      "files": ["apps/app-tanstack-react-start/src/routes/**/*"],
      "rules": {
        "unicorn/filename-case": ["error", { "cases": { "camelCase": true, "kebabCase": true } }]
      }
    }
  ],
  "ignorePatterns": [
    "**/dist/**",
    "**/build/**",
    "**/.next/**",
    "**/api/**",
    "**/public/build/**",
    "**/.cache/**",
    "**/.turbo/**",
    "**/.react-router/**",
    "**/storybook-static/**",
    "**/node_modules/**",
    ".tanstack/**"
  ]
}
