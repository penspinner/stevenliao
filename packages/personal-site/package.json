{
  "name": "personal-site",
  "version": "0.0.0",
  "private": true,
  "files": [
    "./dist",
    "./src/tailwind.css"
  ],
  "type": "module",
  "module": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    },
    "./tailwind.css": "./src/tailwind.css"
  },
  "scripts": {
    "build": "tsdown index.ts client.ts --format esm --dts",
    "check:ts": "tsc --noEmit",
    "watch": "pnpm run build --watch"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-slot": "^1.2.4",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss-cli": "^11.0.1",
    "postcss-focus-visible": "^11.0.0",
    "tailwindcss": "^4.2.4",
    "tsconfig": "workspace:*",
    "tsdown": "^0.21.10",
    "typescript": "^6.0.3"
  }
}
